      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        720
      ],
      "id": "81bc2d6c-f085-4f03-9a46-0633a32d2fcb",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    repository_full_name,\n    COALESCE(category, event_type) as activity_type,\n    priority,\n    ai_summary\nFROM github_events\nWHERE processed_at >= NOW() - INTERVAL '24 hours'\n  AND repository_full_name IS NOT NULL\nORDER BY \n    CASE priority \n        WHEN 'high' THEN 1 \n        WHEN 'medium' THEN 2 \n        WHEN 'low' THEN 3 \n        ELSE 4 \n    END,\n    processed_at DESC;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        720
      ],
      "id": "055e4835-4838-4388-8e91-0272308944c0",
      "name": "Execute a SQL query",
      "credentials": {
        "postgres": {
          "id": "PXTTiPIE9gEVRtdD",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet summaryText = \"Here is the GitHub activity from the last 24 hours:\\n\\n\";\nlet count = 0;\n\nitems.forEach(item => {\n  // Filter out the ping/null glitch so the AI doesn't get confused\n  if (!item.json.repository_full_name || item.json.repository_full_name === 'null') {\n    return;\n  }\n\n  const repo = item.json.repository_full_name;\n  \n  // FIX: Look for activity_type first, then event_type\n  const event = item.json.activity_type || item.json.event_type || 'Unknown Event';\n  \n  const priority = item.json.priority || 'unclassified';\n  const summary = item.json.ai_summary || 'No AI summary available.';\n\n  summaryText += `- **[${priority.toUpperCase()}]** ${repo} (${event}): ${summary}\\n`;\n  count++;\n});\n\nif (count === 0) {\n  summaryText = \"No valid activity recorded in the last 24 hours.\";\n}\n\nreturn [{ json: { daily_activity_text: summaryText } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        720
      ],
      "id": "77ea8939-6046-4496-81df-560a408d5722",
      "name": "Aggregate Events for AI"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.daily_activity_text }}",
        "messages": {
